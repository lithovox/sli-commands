{
  "name": "slicmd-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Web version of slicmd, runs the settlement Python package in the browser with Pyodide",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "copy-pyodide": "node scripts/copy-pyodide.mjs",
    "dev": "npm run copy-pyodide && vite",
    "build": "npm run copy-pyodide && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "pyodide": "314.0.7"
  },
  "devDependencies": {
    "@fontsource/outfit": "5.3.0",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "24.19.2",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
