# Caddy config of the published site, /etc/caddy/apps/sli.caddy on the server.
# The headers must match web/security-headers.ts, a unit test checks this.
# The deploy job in .github/workflows/build.yml uploads to releases/ and points current at it.

sli.lithovox.nl {
	root * /var/www/apps/sli/current
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data:; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Vite puts a hash in these file names, so they never change
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# the page, Pyodide and the flags keep their names, the browser checks them after a deploy
	@unhashed not path /assets/*
	header @unhashed Cache-Control "no-cache"

	file_server
}
